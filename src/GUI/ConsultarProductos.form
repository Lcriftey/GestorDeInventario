            </constraints>
            <properties>
              <font name="Comic Sans MS" size="14" style="3"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="88415" class="javax.swing.JLabel" binding="lblConsultaNombre">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
